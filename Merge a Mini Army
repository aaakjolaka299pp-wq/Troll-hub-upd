local function RefreshStatus()
	local plot  = GetMyPlot()
	local text
	if plot then
		local units  = GetMyUnits(plot)
		local groups = GroupByTier(units)
		local pairsCount, lines = 0, {}
		for tier, list in pairs(groups) do
			if #list >= 2 then
				pairsCount = pairsCount + 1
				table.insert(lines, ("• %s ×%d"):format(list[1].TierText or tier, #list))
			end
		end
		table.sort(lines)
		text = ("Plot: %s | Unit: %d | Tier Kembar: %d\n%s")
			:format(plot.Name, #units, pairsCount, table.concat(lines, "\n"))
	else
		text = "Plot belum ditemukan!"
	end
	pcall(function() StatusLabel:SetText(text) end)
end

