end)

-- Multi-Threading Loop Controller
local activeThreads = {}

local function setLoopState(key, enabled, loopFunc, delayTime)
    if activeThreads[key] then
        task.cancel(activeThreads[key])
        activeThreads[key] = nil
    end

    if enabled then
        activeThreads[key] = task.spawn(function()
            while enabled do
                pcall(loopFunc)
                task.wait(delayTime or 0.3)
            end
        end)
    end
end

-- 3. HELPER FUNCTIONS

local function GetCharacter()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp  = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 5)
    local hum  = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
    return char, hrp, hum
end

local function SafeTeleport(cframe)
    local _, hrp, hum = GetCharacter()
    if hrp and hum and hum.Health > 0 then
        pcall(function()
            hrp.CFrame = cframe
        end)
    end
end

local function MoveToolsToBackpack()
    local char = GetCharacter()
    if char then
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") then
                pcall(function()
                    tool.Parent = LocalPlayer:WaitForChild("Backpack", 2)
                end)
            end
        end
    end
end

-- Fast & Optimized ProximityPrompt Trigger
local function TriggerNearbyPrompts(maxDistance)
    local _, hrp = GetCharacter()
    if not hrp then return end

    maxDistance = maxDistance or 25

    for _, descendant in ipairs(Workspace:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") and descendant.Enabled then
            local parent = descendant.Parent
            local pos    = nil

            if parent:IsA("BasePart") then
                pos = parent.Position
            elseif parent:IsA("Model") and parent.PrimaryPart then
                pos = parent.PrimaryPart.Position
            elseif parent:IsA("Attachment") then
                pos = parent.WorldPosition
            end

            if pos and (hrp.Position - pos).Magnitude <= maxDistance then
                pcall(function()
                    if fireproximityprompt then
                        fireproximityprompt(descendant)
                    else
                        -- Fallback jika executor tidak support fireproximityprompt
                        descendant:InputHoldBegin()
                        task.wait(descendant.HoldDuration)
                        descendant:InputHoldEnd()
                    end
                end)
            end
        end
    end
end

-- Remote Finder Utility
local function GetRemote(remoteName)
    local shared = ReplicatedStorage:FindFirstChild("SharedModules")
    if shared then
        local net = shared:FindFirstChild("Network")
        if net then
            local remotes = net:FindFirstChild("Remotes")
            if remotes then
                return remotes:FindFirstChild(remoteName)
            end
        end
    end
    return nil
end

