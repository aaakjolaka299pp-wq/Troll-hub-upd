   end,
})

-- Loop: Auto Hit
task.spawn(function()
    while true do
        if autoHit then
            pcall(function()
                local remote = game:GetService("ReplicatedStorage"):FindFirstChild("RemoteEvent")
                if remote then
                    local args = {{{ "\024", { "HitWall", "BlockWall1" } }}}
                    remote:FireServer(unpack(args))
                end
            end)
        end
        task.wait() 
    end
end)

-- Loop: Smart Farm
task.spawn(function()
    while true do
        if smartFarm then
            pcall(function()
                local modelFolder = workspace:FindFirstChild("BrainrotFolder") 
                    and workspace.BrainrotFolder:FindFirstChild("model")
                
                if modelFolder then
                    for _, item in pairs(modelFolder:GetChildren()) do
                        if not smartFarm then break end
                        
                        if isAllowed(item.Name) then
                            local prompt = item:FindFirstChildWhichIsA("ProximityPrompt", true)
                            if prompt and prompt.Enabled then
                                fireproximityprompt(prompt)
                                task.wait()
                            end
                        end
                    end
                end
            end)
        end
        task.wait()
    end
end)
