-- Variables
local autoHit = false
local smartFarm = false
local targetIDs = {19, 42, 86, 102, 105, 136, 139, 147}

-- Helper Functions
local function isAllowed(itemName)
    local idNumber = tonumber(itemName:match("Brainrot_(.+)")) or tonumber(itemName)
    if idNumber then
        for _, allowedID in ipairs(targetIDs) do
            if idNumber == allowedID then return true end
        end
    end
    return false
end

-- Toggles
local HitToggle = MainTab:CreateToggle({
