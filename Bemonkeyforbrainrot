MainRight:AddToggle("AutoX2Power", {
    Text    = "Auto X2 Power",
    Default = false,
    Tooltip = "Auto klik tombol 2x Power via VirtualInput",
    Callback = function(state)
        if state then
            startLoop("AutoX2Power", function()
                local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
                if playerGui then
                    local popUp = playerGui:FindFirstChild("PopUp")
                    if popUp then
                        local buttonContainer = popUp:FindFirstChild("2xButton") or popUp:FindFirstChild("x2Button")
                        if buttonContainer and buttonContainer.Visible then
                            local pos = buttonContainer.AbsolutePosition
                            local size = buttonContainer.AbsoluteSize
                            local x = pos.X + (size.X / 2)
                            local y = pos.Y + (size.Y / 2) + 36

                            VirtualInput:SendMouseButtonEvent(x, y, 0, true, game, 0)
                            task.wait(0.05)
                            VirtualInput:SendMouseButtonEvent(x, y, 0, false, game, 0)
                        end
                    end
                end
            end, function() return Options.AutoX2PowerDelay.Value end)
        else
            stopLoop("AutoX2Power")
        end
    end,
})
