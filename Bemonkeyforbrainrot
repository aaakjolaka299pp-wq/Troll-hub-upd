local function getMyBaseName()
    local basesFolder = Workspace:FindFirstChild("Base")
    if not basesFolder then return nil end

    for _, base in ipairs(basesFolder:GetChildren()) do
        for _, child in ipairs(base:GetDescendants()) do
            if (child:IsA("StringValue") or child:IsA("ObjectValue")) and (child.Value == LocalPlayer.Name or child.Value == LocalPlayer) then
                return base.Name
            elseif child:IsA("TextLabel") and string.find(child.Text, LocalPlayer.Name) then
                return base.Name
            end
        end
    end
    return nil
end

