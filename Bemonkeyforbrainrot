MainLeft:AddToggle("AutoCollectCash", {
    Text    = "Auto Collect Cash",
    Default = false,
    Tooltip = "Auto scan podium 1-50 pada base kamu",
    Callback = function(state)
        if state then
            startLoop("AutoCollectCash", function()
                local myBaseName = getMyBaseName()
                if myBaseName then
                    local baseObj = Workspace.Base:FindFirstChild(myBaseName)
                    if baseObj and baseObj:FindFirstChild("Podiums") then
                        for i = 1, 50 do
                            if not Toggles.AutoCollectCash.Value then break end
                            local podium = baseObj.Podiums:FindFirstChild("Podium" .. i)
                            if podium then
                                local cashClaim = podium:FindFirstChild("CashClaim")
                                if cashClaim then
                                    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                                    if hrp then
                                        if firetouchinterest then
                                            firetouchinterest(hrp, cashClaim, 0)
                                            task.wait(0.01)
                                            firetouchinterest(hrp, cashClaim, 1)
                                        else
                                            cashClaim.CFrame = hrp.CFrame
                                        end
                                    end

                                    local prompt = cashClaim:FindFirstChildWhichIsA("ProximityPrompt", true)
                                    if prompt and fireproximityprompt then
                                        fireproximityprompt(prompt)
                                    end
                                end
                            end
                            task.wait(0.01)
                        end
                    end
                end
            end, function() return Options.AutoCollectCashDelay.Value end)
        else
            stopLoop("AutoCollectCash")
        end
    end,
})
MainLeft:AddSlider("AutoCollectCashDelay", {
    Text = "Auto Collect Cash Delay", Default = 0.1, Min = 0, Max = 5, Rounding = 2, Suffix = "s",
})

