UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe or not (Toggles.ClickTeleport and Toggles.ClickTeleport.Value) then return end
    if input.KeyCode ~= Enum.KeyCode.F and input.UserInputType ~= Enum.UserInputType.Touch then return end
    pcall(function()
        local mouse = LocalPlayer:GetMouse()
        local root  = GetRoot()
        local offset = Options.TeleportOffset and Options.TeleportOffset.Value or 3
        if root and mouse and mouse.Hit then
            root.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, offset, 0))
        end
    end)
end)

