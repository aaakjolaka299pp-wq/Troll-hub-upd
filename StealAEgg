local function SmoothMoveTo(targetPos, toggleKey)
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    if not hrp then return false end

    while Toggles[toggleKey] and Toggles[toggleKey].Value do
        local currentPos = hrp.Position
        local distance = (targetPos - currentPos).Magnitude
        
        if distance < 4 then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
            return true
        end

        local direction = (targetPos - currentPos).Unit
        local speed = math.min(300, distance * 25)
        
        hrp.CFrame = CFrame.new(currentPos + direction * speed * RunService.Heartbeat:Wait(), targetPos)
        hrp.AssemblyLinearVelocity = Vector3.zero
    end
    return false
end

local function RunFarmLogic(targetPos, toggleKey)
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hum = char:WaitForChild("Humanoid", 5)
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    local animator = hum:WaitForChild("Animator", 5)

    if not (char and hum and hrp) then return end

    local animTrack
    pcall(function()
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://507765644"
        animTrack = animator:LoadAnimation(anim)
        animTrack.Looped = true
        animTrack:Play()
        animTrack:AdjustSpeed(2.5)
    end)

    pcall(function()
        if SmoothMoveTo(targetPos, toggleKey) then
            task.wait(0.5)

            if Toggles[toggleKey] and Toggles[toggleKey].Value then
                local closestPromptPart = nil
                local closestPos = nil
                local shortestDist = math.huge

                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj.Name == "SmartPromptPart" and (obj:IsA("BasePart") or obj:IsA("Model")) then
                        local pPos = obj:IsA("BasePart") and obj.Position or obj:GetPivot().Position
                        local dist = (hrp.Position - pPos).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            closestPos = pPos
                            closestPromptPart = obj
                        end
                    end
                end

                if closestPromptPart and closestPos then
                    SmoothMoveTo(closestPos, toggleKey)
                    for _, prompt in ipairs(closestPromptPart:GetDescendants()) do
                        if prompt:IsA("ProximityPrompt") then
                            pcall(function()
                                prompt.MaxActivationDistance = math.huge
                                if fireproximityprompt then
                                    fireproximityprompt(prompt)
                                else
                                    prompt:InputHoldBegin()
                                    task.wait(prompt.HoldDuration or 0.1)
                                    prompt:InputHoldEnd()
                                end
                            end)
                        end
                    end
                    task.wait(0.2)
                end
            end
        end

        SmoothMoveTo(Vector3.new(488, 71, -362), toggleKey)
    end)

    if animTrack then pcall(function() animTrack:Stop() end) end
    pcall(function()
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end)
end

