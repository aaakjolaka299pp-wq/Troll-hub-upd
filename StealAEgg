-- AUTO HATCH
AutoGroupLeft:AddToggle("AutoHatch", {
    Text    = "Auto Hatch Eggs",
    Default = false,
    Tooltip = "Auto hatch telur yang sudah siap di-hatch",
    Callback = function(state)
        if state then
            startLoop("AutoHatch", function()
                local eggCmds = require(ReplicatedStorage.Library.Client.EggCmds)
                local eggRenderer = require(ReplicatedStorage.Library.Client.Eggs.PlacedEggRenderer)
                local eggItemUtil = require(ReplicatedStorage.Library.Util.EggItemUtil)

                local records = eggCmds.GetOwnerRuntimeRecords(LocalPlayer.UserId)
                if records then
                    local serverTime = Workspace:GetServerTimeNow()
                    for eggId, recordData in pairs(records) do
                        if recordData.Placement ~= nil then
                            local alpha = eggItemUtil.GetGrowthAlpha(
                                recordData, 
                                serverTime, 
                                recordData.GrowthSpeedMultiplier, 
                                eggItemUtil.GetCurrentNightGrowthCreditSeconds(recordData, serverTime, recordData.GrowthSpeedMultiplier)
                            )
                            if alpha >= 1 then
                                eggRenderer.ActivateLocalEgg(eggId)
                            end
                        end
                    end
                end
            end, function() return Options.AutoHatchDelay.Value end)
        else
            stopLoop("AutoHatch")
        end
    end,
})

AutoGroupLeft:AddSlider("AutoHatchDelay", {
    Text = "Auto Hatch Delay", Default = 1, Min = 0.1, Max = 5, Rounding = 1, Suffix = "s",
})

