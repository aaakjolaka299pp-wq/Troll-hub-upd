    FarmGroup:AddToggle(toggleKey, {
        Text    = zone.Name,
        Default = false,
        Tooltip = "Auto farm di area " .. zone.Name,
        Callback = function(state)
            if state then
                startLoop(toggleKey, function()
                    RunFarmLogic(zone.Pos, toggleKey)
                end, function() return 0.1 end)
            else
                stopLoop(toggleKey)
            end
        end,
    })
end

