-- AUTO UPGRADE TREADMILL
AutoGroupLeft:AddToggle("AutoUpgradeTreadmill", {
    Text    = "Auto Upgrade Treadmill",
    Default = false,
    Tooltip = "Auto upgrade treadmill saat uang mencukupi",
    Callback = function(state)
        if state then
            startLoop("AutoUpgradeTreadmill", function()
                local upgradeRemote = ReplicatedStorage:WaitForChild("Network"):WaitForChild("Treadmills: RequestUpgrade")
                local saveLib = require(ReplicatedStorage.Library.Client.Save)
                local treadmillDir = require(ReplicatedStorage.Directory.Treadmills)

                local pData = saveLib.Get()
                if pData then
                    local currentLvl = pData.TreadmillUpgradeLevel or 0
                    local nextUpgrade = treadmillDir.GetByUpgradeLevel(currentLvl + 1)
                    if nextUpgrade and (pData.Money or 0) >= nextUpgrade.Price then
                        upgradeRemote:InvokeServer(nextUpgrade._id)
                    end
                end
            end, function() return Options.AutoUpgradeTreadmillDelay.Value end)
        else
            stopLoop("AutoUpgradeTreadmill")
        end
    end,
})

AutoGroupLeft:AddSlider("AutoUpgradeTreadmillDelay", {
    Text = "Upgrade Delay", Default = 1, Min = 0.1, Max = 5, Rounding = 1, Suffix = "s",
})

