-- Remote Invoker Helper
local function FireRemote(remoteName, remoteType, argument)
	task.spawn(function()
		pcall(function()
			local remoteFolder = ReplicatedStorage:WaitForChild("Utilities", 5):WaitForChild("TypedRemote", 5)
			if remoteFolder then
				local remote = remoteFolder:FindFirstChild(remoteName)
				if remote then
					if remoteType == "Event" then
						remote:FireServer(argument)
					elseif remoteType == "Function" then
						remote:InvokeServer(argument)
					end
				end
			end
		end)
	end)
end

