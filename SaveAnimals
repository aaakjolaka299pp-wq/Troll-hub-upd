local function RunAutoFarmLoop(zooName, targetCFrame, toggleIndex)
	task.spawn(function()
		local homePosition = Vector3.new(117, 9, 65)
		
		while Toggles[toggleIndex] and Toggles[toggleIndex].Value do
			local character = LocalPlayer.Character
			if character and character:FindFirstChild("HumanoidRootPart") then
				local hrp = character.HumanoidRootPart
				
				-- Teleport ke Zoo Target
				hrp.CFrame = CFrame.new(targetCFrame)
				task.wait(0.2)
				
				-- Cari ProximityPrompt Terdekat
				local nearestPrompt = nil
				local nearestPart = nil
				local shortestDistance = math.huge
				
				for _, obj in ipairs(workspace:GetDescendants()) do
					if obj:IsA("ProximityPrompt") and obj.Enabled then
						local parentPart = obj.Parent
						local partPos = nil
						
						if parentPart:IsA("BasePart") then
							partPos = parentPart.Position
						elseif parentPart:IsA("Model") and parentPart.PrimaryPart then
							partPos = parentPart.PrimaryPart.Position
						end
						
						if partPos then
							local dist = (hrp.Position - partPos).Magnitude
							if dist < shortestDistance then
								shortestDistance = dist
								nearestPrompt = obj
								nearestPart = parentPart
							end
						end
					end
				end
				
				-- Interaksi
				if nearestPrompt and nearestPart then
					hrp.CFrame = nearestPart:IsA("BasePart") and nearestPart.CFrame or nearestPart:GetPivot()
					task.wait(0.1)
					
					if fireproximityprompt then
						fireproximityprompt(nearestPrompt)
					else
						nearestPrompt:InputHoldBegin()
						task.wait(nearestPrompt.HoldDuration)
						nearestPrompt:InputHoldEnd()
					end
					task.wait(0.1)
				end
				
				-- Kembali ke Safezone
				hrp.CFrame = CFrame.new(homePosition)
			end
			task.wait(0.8)
		end
	end)
end

-- Dynamic Toggles Generation
for _, zoo in ipairs(ZooLocations) do
	local toggleIdx = "Farm_" .. zoo.Name:gsub("%s+", "_")
	
	zoo.Group:AddToggle(toggleIdx, {
		Text = "Auto " .. zoo.Name,
		Default = false,
		Tooltip = "Otomatis farm di " .. zoo.Name,
	})
	
	Toggles[toggleIdx]:OnChanged(function()
		if Toggles[toggleIdx].Value then
			RunAutoFarmLoop(zoo.Name, zoo.CFrame, toggleIdx)
		end
	end)
end

