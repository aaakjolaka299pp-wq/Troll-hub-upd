-- AUTO FARM MYTHICAL
MainLeft:AddToggle("AutoFarmMythical", {
    Text    = "Auto Farm Mythical",
    Default = false,
    Tooltip = "Otomatis Farm Mythical Super Cepat",
    Callback = function(state)
        if state then
            startLoop("AutoFarmMythical", function()
                local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local mythicalItems = findMythicalTargets()
                    if #mythicalItems > 0 then
                        if not originalCFrame then originalCFrame = hrp.CFrame end
                        for _, target in ipairs(mythicalItems) do
                            if not Toggles.AutoFarmMythical.Value then break end
                            local targetCFrame = nil
                            local targetPart = nil
                            if target:IsA("BasePart") then
                                targetCFrame = target.CFrame
                                targetPart = target
                            elseif target:IsA("Model") then
                                targetCFrame = target:GetPivot() or (target.PrimaryPart and target.PrimaryPart.CFrame)
                                targetPart = target
                            end

                            if targetCFrame and targetPart then
                                if not isInsideBaseOrPlot(targetPart) then
                                    hrp.CFrame = targetCFrame * CFrame.new(0, 1.5, 0)
                                    task.wait(0.02)
                                    forceInstantPickUp(targetPart)
                                    task.wait(0.05)
                                    if originalCFrame then hrp.CFrame = originalCFrame end
                                    task.wait(0.05)
                                end
                            end
                        end
                    end
                else
                    originalCFrame = nil
                end
            end, function() return Options.AutoFarmMythicalDelay.Value end)
        else
            stopLoop("AutoFarmMythical")
            originalCFrame = nil
        end
    end,
})
MainLeft:AddSlider("AutoFarmMythicalDelay", {
