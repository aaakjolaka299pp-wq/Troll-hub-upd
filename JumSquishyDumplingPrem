-- Helpers
local function fireTouchFast(part, characterPart)
    if firetouchinterest and part and characterPart then
        task.spawn(function()
            firetouchinterest(characterPart, part, 0)
            task.wait()
            firetouchinterest(characterPart, part, 1)
        end)
    end
end

local function getMyPlot()
    local myName = string.lower(LocalPlayer.Name)
    local myDisplayName = string.lower(LocalPlayer.DisplayName)
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            local text = string.lower(obj.Text)
            if (string.find(text, myName) or string.find(text, myDisplayName)) and string.find(text, "plot") then
                local plotModel = obj:FindFirstAncestorWhichIsA("Model") or obj:FindFirstAncestorWhichIsA("Folder")
                if plotModel then return plotModel end
            end
        end
    end
    return nil
end

local function collectCashFromMyPlotFast()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local myPlot = getMyPlot()
    if myPlot then
        for _, obj in ipairs(myPlot:GetDescendants()) do
            if obj:IsA("TextLabel") or obj:IsA("TextButton") then
                if string.find(obj.Text, "%$") then
                    local parentPart = obj:FindFirstAncestorWhichIsA("BasePart")
                    if parentPart then fireTouchFast(parentPart, hrp) end
                end
            end
        end
    end
end

local function forceInstantPickUp(part)
    for _, prompt in ipairs(part:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            prompt.HoldDuration = 0
            if fireproximityprompt then fireproximityprompt(prompt) end
        end
    end
end

local function isInsideBaseOrPlot(obj)
    local current = obj
    while current and current ~= Workspace do
        local nameLower = string.lower(current.Name)
        if string.find(nameLower, "plot") or string.find(nameLower, "base") or string.find(nameLower, "tycoon") or string.find(nameLower, "player") or string.find(nameLower, "house") then
            return true
        end
        current = current.Parent
    end
    return false
end

local function findMythicalTargets()
    local targets = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            if string.find(string.lower(obj.Text), "mythical") then
                if not isInsideBaseOrPlot(obj) then
                    local parentPart = obj:FindFirstAncestorWhichIsA("BasePart") or obj:FindFirstAncestorWhichIsA("Model")
                    if parentPart and not isInsideBaseOrPlot(parentPart) then
                        table.insert(targets, parentPart)
                    end
                end
            end
        end
    end
    return targets
end

